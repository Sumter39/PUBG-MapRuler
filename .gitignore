# ============================================================================
# PUBG-MapRuler —— 忽略规则
# 原则：仓库里只放代码和文档，任何「运行时生成」或「本机打包产物」都不入库
# ============================================================================

# --- 打包产物 ---------------------------------------------------------------
# PyInstaller 的中间目录与最终 EXE。EXE 用 python build.py 现打现用，
# 每次构建都重新生成，入库只会徒增体积与合并冲突。
build/
dist/

# --- 运行时数据 -------------------------------------------------------------
# 便携模式数据目录（settings.ini / place.log / dxgi.log / 留帧 frames/ /
# 扫描日志 scan.log）。开发态生成在项目根，打包态生成在 EXE 旁边，
# 两处都会被这条规则盖住。里面是本机屏幕截图，更不该进公共仓库。
PUBG-MapRuler-Data/

# --- Oodle 测试语料 ---------------------------------------------------------
# vendor/ooz/ooz-src 是上游 ooz 的源码副本（pak 解包参考），官方测试语料
# 300+ MB，需要的话从上游仓库拉，不入库。
vendor/ooz/ooz-src/testdata/

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/

# --- 编辑器 / IDE -----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo

# --- 系统 -------------------------------------------------------------------
Thumbs.db
Desktop.ini
desktop.ini
.DS_Store

# --- 杂项 -------------------------------------------------------------------
*.log
*.pid
*.bak
