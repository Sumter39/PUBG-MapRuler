# ============================================================================
# PUBG-MapRuler —— 忽略规则
# 原则：仓库里只放代码和文档，任何「运行时生成」或「本机打包产物」都不入库
# ============================================================================

# --- 打包产物 ---------------------------------------------------------------
# PyInstaller 的中间目录与最终 EXE。EXE 用 python build.py 现打现用，
# 每次构建都重新生成，入库只会徒增体积与合并冲突。
build/
dist/

# --- 运行时数据 -------------------------------------------------------------
# 便携模式数据目录（settings.ini / place.log / dxgi.log / 留帧 frames/ /
# 扫描日志 scan.log）。开发态生成在项目根，打包态生成在 EXE 旁边，
# 两处都会被这条规则盖住。里面是本机屏幕截图，更不该进公共仓库。
# 下一行是 v4.0.0 改名前的旧数据目录名，老 EXE 在项目根跑过会留下，一并忽略。
PUBG-MapRuler-Data/
PUBGMapOverlayEx-Data/

# --- 识别回归测试集 ---------------------------------------------------------
# testset/ 存本机留帧副本：不同缩放档、不同队伍色、叠标/遮挡等难样本，
# 每个样本都带 expected.json 里的期望槽位与距离。每次改识别链路后跑
# `python tools/testset_eval.py` 对账。截图是本机数据，不入公共仓库。
# 规则见 docs/design.md「测试集与回归」。
testset/

# --- 第三方逆向工具（本地自备，不入库）---------------------------------------
# vendor/ 整体不入库：oo2core_9 DLL 是 RAD 专有文件，公开再分发违反其
# 许可；unpaker 从上游 Release 下载。本地保留，重新克隆后需自行放置。
vendor/

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/

# --- 编辑器 / IDE -----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo

# --- 系统 -------------------------------------------------------------------
Thumbs.db
Desktop.ini
desktop.ini
.DS_Store

# --- 杂项 -------------------------------------------------------------------
*.log
*.pid
*.bak

# ZCode 在本项目里开的会话工作目录
.zcode/

# --- 临时目录 / 散落临时文件（诊断产物，用完即删）---
.tmp/
.tmp_*
